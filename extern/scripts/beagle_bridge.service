[Unit]
Description=BeaglePlay Freedom bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=debian
Group=debian
RemainAfterExit=yes
ExecStart=/home/debian/extern/scripts/beagle_bridge.sh start
ExecStop=/home/debian/extern/scripts/beagle_bridge.sh stop

[Install]
WantedBy=multi-user.target
